rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email)) ||
          (request.auth.token.email == "boldsaihanlolor@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'available', 'description']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.price is number && data.price >= 0 &&
             data.category in ['European', 'Asian', 'Drinks', 'Mongolian', 'Specials', 'Draft'] &&
             data.available is bool &&
             data.description is string &&
             (!('sideImages' in data) || data.sideImages is list) &&
             (!('portions' in data) || data.portions is list) &&
             (!('packagingPrice' in data) || (data.packagingPrice is number && data.packagingPrice >= 0));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['items', 'total', 'orderType', 'status', 'timestamp']) &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() < 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 20)) &&
             data.orderType in ['pickup', 'kiosk'] &&
             (!('kioskNumber' in data) || (data.kioskNumber is string && data.kioskNumber.size() < 50)) &&
             (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() >= 3)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() < 500)) &&
             data.status in ['pending', 'preparing', 'ready', 'completed', 'cancelled'] &&
             data.timestamp is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Admin Emails
    match /admin_emails/{email} {
      allow read, write: if isAdmin();
    }

    // Menu Items
    match /menu/{itemId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidMenuItem(request.resource.data);
      allow delete: if isAdmin();
      allow update: if (isAdmin() && isValidMenuItem(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderCount']) &&
         request.resource.data.orderCount > resource.data.orderCount);
    }

    // Payment fields no client may set at create time — not even an admin.
    // Only Cloud Functions (Admin SDK bypasses rules) confirm payments: a
    // customer creating an order pre-marked CONFIRMED would walk past every
    // payment gate in the app, and an admin doing it bypasses the state guard
    // in markOrderPaid. Zero-charge admin test orders are created
    // AWAITING_PAYMENT and confirmed through confirmOrderPayment like any
    // other order.
    //
    // amountMnt / paymentExpiresAt / referenceCode stay client-settable: they
    // are set at order creation before any money moves.
    function hasNoForgedPayment(data) {
      return (!('paymentStatus' in data) || data.paymentStatus == 'AWAITING_PAYMENT') &&
             !('paidAt' in data) &&
             !('paidVia' in data) &&
             !('qpayPaymentId' in data) &&
             !('qpayPaymentType' in data) &&
             !('qpayPaymentWallet' in data) &&
             !('monpayTxnId' in data) &&
             !('matchedTxId' in data);
    }

    // Payment fields no client may MODIFY. The server owns every one of these;
    // confirmOrderPayment / qpayWebhook / refundQpayPayment / the expiry job
    // write them with the Admin SDK, which is not subject to these rules.
    // Admins keep full control of the kitchen `status` field.
    function touchesPaymentFields(prev, next) {
      return next.diff(prev).affectedKeys().hasAny([
        'paymentStatus',
        'paidAt',
        'paidVia',
        'qpayPaymentId',
        'qpayPaymentType',
        'qpayPaymentWallet',
        'monpayTxnId',
        'matchedTxId',
      ]);
    }

    // Orders
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data) &&
        hasNoForgedPayment(request.resource.data);
      allow read: if true; // Allow customers to track their order
      allow update: if (isAdmin() &&
                        !touchesPaymentFields(resource.data, request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status == 'cancelled' &&
         resource.data.status == 'pending');
      // Customers may abandon their own unpaid order, but a CONFIRMED
      // payment is a money record — only admins can remove those.
      allow delete: if isAdmin() ||
        (resource.data.status == 'pending' &&
         (!('paymentStatus' in resource.data) || resource.data.paymentStatus != 'CONFIRMED'));
    }

    // Bank transactions — the reconciliation ledger behind the bank-transfer
    // rail. Had no rule at all until now, so every read and write from the admin
    // dashboard was hitting the default deny.
    //
    // Entries are typed by an admin and matched by reconcileBankTransaction /
    // sweepBankTransactions, which use the Admin SDK and bypass these rules.
    // From a client: admins read, and may add an entry, but may not write the
    // match fields — the server owns those.
    match /bank_transactions/{txId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.source == 'manual' &&
        request.resource.data.amountMnt is number &&
        request.resource.data.amountMnt > 0 &&
        request.resource.data.direction in ['credit', 'debit'] &&
        request.resource.data.description is string &&
        (!('matchStatus' in request.resource.data) ||
         request.resource.data.matchStatus == 'unmatched') &&
        !('matchedOrderId' in request.resource.data);
      // matchStatus / matchedOrderId are server-computed; no client edits them.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Store settings (open/close hours) — read by every visitor's
    // StoreSettingsContext; without this rule the default deny made the
    // store-hours feature invisible to customers.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stats (for order numbers)
    match /stats/{statId} {
      allow read, write: if isAdmin();
    }

    // Users (for role management)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
